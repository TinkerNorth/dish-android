<?xml version="1.0" encoding="utf-8"?>
<!-- One capability (Rumble / Motion / Touchpad) with its three Input · Destination
     · Type checks. Rows are inflated into a type card's container per candidate
     type; the name, status, and the three check/cancel glyphs are set from code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/capName"
            style="@style/TextAppearance.Dish.BodySmall.Mono.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Motion / gyro" />

        <TextView
            android:id="@+id/capStatus"
            style="@style/TextAppearance.Dish.Label.Tight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            tools:text="Available" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/spacing_xs">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/capInput"
                style="@style/TextAppearance.Dish.Label.Plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:text="@string/setup_cap_input"
                tools:drawableEnd="@drawable/ic_check_circle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/capDestination"
                style="@style/TextAppearance.Dish.Label.Plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:text="@string/setup_cap_destination"
                tools:drawableEnd="@drawable/ic_check_circle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/capType"
                style="@style/TextAppearance.Dish.Label.Plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/spacing_xs"
                android:gravity="center_vertical"
                android:text="@string/setup_cap_type"
                tools:drawableEnd="@drawable/ic_cancel" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
