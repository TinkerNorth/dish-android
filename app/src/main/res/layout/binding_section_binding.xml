<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/config_section_icon_size"
            android:layout_height="@dimen/config_section_icon_size"
            android:layout_marginEnd="@dimen/config_section_icon_gap"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tune"
            app:tint="@color/colorPrimary" />

        <TextView
            style="@style/TextAppearance.Dish.Label.Accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/binding_label_binding"
            android:textAllCaps="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/config_section_header_gap"
        android:orientation="vertical">

        <TextView
            style="@style/Widget.Dish.MicroLabel"
            android:layout_width="wrap_content"
            android:text="@string/binding_label_emulate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emulateDropdown"
            style="@style/Widget.Dish.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="start|center_vertical"
            app:icon="@drawable/ic_chevron_down"
            app:iconGravity="end"
            app:iconTint="@color/colorMuted" />

        <!-- Shown in place of the dropdown while a satellite host's catalog is (re)loading the type. -->
        <ProgressBar
            android:id="@+id/emulateLoading"
            android:layout_width="@dimen/binding_edge_spinner_size"
            android:layout_height="@dimen/binding_edge_spinner_size"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:indeterminate="true"
            android:indeterminateTint="@color/colorPrimary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emulatePill"
            style="@style/Widget.Dish.Pill"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_binding_pill_fact"
            android:visibility="gone">

            <ImageView
                style="@style/Widget.Dish.Pill.Icon"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEmulateText"
                style="@style/Widget.Dish.Pill.Text"
                android:textColor="@color/colorOnSurface" />
        </LinearLayout>

        <View
            android:id="@+id/motionDivider"
            style="@style/Widget.Dish.Divider"
            android:layout_marginTop="@dimen/config_row_gap"
            android:layout_marginBottom="@dimen/config_row_gap"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/motionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/config_row_icon_size"
                android:layout_height="@dimen/config_row_icon_size"
                android:layout_marginEnd="@dimen/config_row_icon_gap"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_motion"
                app:tint="@color/colorPrimary" />

            <TextView
                style="@style/TextAppearance.Dish.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/binding_func_motion"
                android:textColor="@color/colorOnSurface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swMotion"
                style="@style/Widget.Dish.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:id="@+id/rumbleDivider"
            style="@style/Widget.Dish.Divider"
            android:layout_marginTop="@dimen/config_row_gap"
            android:layout_marginBottom="@dimen/config_row_gap"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rumbleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/config_row_icon_size"
                android:layout_height="@dimen/config_row_icon_size"
                android:layout_marginEnd="@dimen/config_row_icon_gap"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_rumble"
                app:tint="@color/colorPrimary" />

            <TextView
                style="@style/TextAppearance.Dish.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/binding_func_rumble"
                android:textColor="@color/colorOnSurface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swRumble"
                style="@style/Widget.Dish.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:id="@+id/micDivider"
            style="@style/Widget.Dish.Divider"
            android:layout_marginTop="@dimen/config_row_gap"
            android:layout_marginBottom="@dimen/config_row_gap"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/micRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/config_row_icon_size"
                android:layout_height="@dimen/config_row_icon_size"
                android:layout_marginEnd="@dimen/config_row_icon_gap"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic"
                app:tint="@color/colorPrimary" />

            <TextView
                style="@style/TextAppearance.Dish.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/binding_func_mic"
                android:textColor="@color/colorOnSurface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swMic"
                style="@style/Widget.Dish.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Only under the mic row, and only while the grant is missing: a switch that
             would silently do nothing says so, and the note itself is the ask. -->
        <TextView
            android:id="@+id/tvMicPermission"
            style="@style/TextAppearance.Dish.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginStart="@dimen/config_row_note_inset"
            android:text="@string/binding_mic_permission_needed"
            android:textColor="@color/colorWarning"
            android:visibility="gone" />

        <!-- Only once the microphone is actually armed: where the mute controls are is the one
             thing a user needs to know before a live microphone reaches their PC. -->
        <TextView
            android:id="@+id/tvMicMuteHint"
            style="@style/TextAppearance.Dish.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:layout_marginStart="@dimen/config_row_note_inset"
            android:text="@string/binding_mic_mute_hint"
            android:textColor="@color/colorOnSurfaceVariant"
            android:visibility="gone" />

        <View
            android:id="@+id/speakerDivider"
            style="@style/Widget.Dish.Divider"
            android:layout_marginTop="@dimen/config_row_gap"
            android:layout_marginBottom="@dimen/config_row_gap"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/speakerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/config_row_icon_size"
                android:layout_height="@dimen/config_row_icon_size"
                android:layout_marginEnd="@dimen/config_row_icon_gap"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_speaker"
                app:tint="@color/colorPrimary" />

            <TextView
                style="@style/TextAppearance.Dish.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/binding_func_speaker"
                android:textColor="@color/colorOnSurface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swSpeaker"
                style="@style/Widget.Dish.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
