<?xml version="1.0" encoding="utf-8"?>
<!-- After a feedback or audio test: "Did it work?" with Yes and No, and the last answer for this
     controller. InputInspectorActivity shows the question only while a test waits for one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_lg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/groupOutcomeQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvOutcomeQuestion"
            style="@style/TextAppearance.Dish.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Rumble, strong: did it work?" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOutcomeNo"
            style="@style/Widget.Dish.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="@string/inspector_outcome_no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOutcomeYes"
            style="@style/Widget.Dish.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:text="@string/inspector_outcome_yes" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLastOutcome"
        style="@style/TextAppearance.Dish.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:visibility="gone"
        tools:text="Last test: Rumble, strong · worked · 12 s ago"
        tools:visibility="visible" />
</LinearLayout>
