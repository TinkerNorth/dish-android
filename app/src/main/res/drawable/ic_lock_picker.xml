<?xml version="1.0" encoding="utf-8"?>
<!-- ic_lock at picker-row size, for rows that carry it as a TextView compound drawable: a compound
     drawable is drawn at its intrinsic size, and the vector's own is 24dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="@dimen/icon_picker_glyph"
        android:height="@dimen/icon_picker_glyph"
        android:drawable="@drawable/ic_lock"
        android:gravity="center" />
</layer-list>
