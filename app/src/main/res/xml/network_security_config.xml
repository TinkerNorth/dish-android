<?xml version="1.0" encoding="utf-8"?>
<!--
    Explicit deny-cleartext config. Every request the app makes through
    the platform URL stack (the HTTPS satellite client API, the Moonlight
    mutual-TLS endpoints, any future telemetry endpoint) MUST be TLS.

    This is a belt-and-braces signal to Android's PlatformVal validator
    and to Play's pre-launch security checks: even if a future PR forgets
    to set `usesCleartextTraffic="false"`, this config still wins.

    NOT everything the app sends is TLS, because this config only gates
    the URL stack. Raw sockets are outside it, and three things use them:

      - the encrypted UDP gamepad wire and the LAN discovery beacons,
        which carry their own AEAD;
      - Moonlight pairing phases 1-4 and the /serverinfo probe, which the
        GameStream protocol fixes as plaintext HTTP on port 47989 because
        no shared secret exists yet. MoonlightPlainHttpClient speaks that
        by hand over a Socket for exactly those requests, and its KDoc
        carries why it is safe (no PIN on the wire; phase 5 onwards is
        pinned mutual TLS).

    So do not read this file as "the app never sends cleartext". Read it
    as "nothing that can go through the URL stack is allowed to."
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Debug-only override: allow cleartext to localhost / 10.0.2.2 so
        Android Studio's emulator <-> host bridge keeps working during
        development. Production builds (debuggable=false) ignore this
        block entirely.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
